{{- $darwin := eq .chezmoi.os "darwin" -}}
{{- $server := eq .role "server" -}}
{{- /* The .pub files only select a key that an agent holds. Desktops ask the
       1Password agent; the server has no key and no agent of its own, so ssh works
       there only through one forwarded by the user (ssh -A). No machine
       keeps a private key on disk. */ -}}
Host *
{{- if $darwin }}
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  UseKeychain yes
{{- else if not $server }}
  IdentityAgent ~/.1password/agent.sock
{{- end }}
  IdentitiesOnly yes
Host github.com
  IdentityFile ~/.ssh/github.pub
Host *.4stack.nl
  ForwardAgent yes
  User deploy
  IdentityFile ~/.ssh/personal.pub
Host *.fourstack.nl
  ForwardAgent yes
  User deploy
  IdentityFile ~/.ssh/personal.pub
Host bas-macbook-pro-2018.local bas-macbook-air.local
  ForwardAgent yes
  IdentityFile ~/.ssh/personal.pub
