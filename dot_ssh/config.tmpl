  User deploy
  IdentityFile ~/.ssh/personal.pub
  IdentityFile ~/.ssh/id_rsa
Host *.fourstack.nl
  ForwardAgent yes
  User deploy
  IdentityFile ~/.ssh/personal.pub
  IdentityFile ~/.ssh/id_rsa
Host bas-macbook-pro-2018.local bas-macbook-air.local
  ForwardAgent yes
  IdentityFile ~/.ssh/personal.pub
  IdentityFile ~/.ssh/id_rsa
