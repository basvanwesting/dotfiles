{{- /* macOS only (see .chezmoiignore); Omarchy uses bash + its own rc layer */ -}}
# PATH
{{ if eq .chezmoi.arch "arm64" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"
{{- else -}}
export PATH="/usr/local/sbin:/usr/local/bin:$PATH"
{{- end }}
export PATH="/Applications/Docker.app/Contents/Resources/bin:$PATH"
export PATH="$PATH:$HOME/.lmstudio/bin"
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
export HOMEBREW_NO_AUTO_UPDATE=1

if [[ -d "$HOMEBREW_PREFIX/opt/postgresql@15" ]]; then
  export PATH="$HOMEBREW_PREFIX/opt/postgresql@15/bin:$PATH"
  export LDFLAGS="-L$HOMEBREW_PREFIX/opt/postgresql@15/lib"
  export CPPFLAGS="-I$HOMEBREW_PREFIX/opt/postgresql@15/include"
  export PKG_CONFIG_PATH="$HOMEBREW_PREFIX/opt/postgresql@15/lib/pkgconfig"
fi

# Completion + history (what oh-my-zsh used to set up; git aliases live in aliases.sh)
autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' menu select
HISTFILE="$HOME/.zsh_history" HISTSIZE=50000 SAVEHIST=50000
setopt share_history extended_history hist_ignore_all_dups hist_ignore_space hist_verify
setopt auto_cd auto_pushd pushd_ignore_dups interactive_comments always_to_end complete_in_word

# Line editor: emacs keys (EDITOR=nvim would make zsh default to vi mode) and
# prefix history search on the arrows, both as oh-my-zsh had them.
bindkey -e
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[OA' up-line-or-beginning-search
bindkey '^[OB' down-line-or-beginning-search

# zsh-autosuggestions: brew on macOS, git clone to ~/.local/share elsewhere
for f in "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" \
         "$HOME/.local/share/zsh-autosuggestions/zsh-autosuggestions.zsh"; do
  [[ -r "$f" ]] && { source "$f"; break; }
done
unset f

# Tools
[[ -f "$HOME/.fzf.zsh" ]] && source "$HOME/.fzf.zsh"
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"
eval "$(mise activate zsh)"
eval "$(direnv hook zsh)"
(( $+commands[starship] )) && eval "$(starship init zsh)"

# Shared with bash on Omarchy
source "$HOME/.config/shell/env.sh"
source "$HOME/.config/shell/aliases.sh"
source "$HOME/.config/shell/functions.sh"

# zsh only (Omarchy's bash has its own eza-based ls aliases)
alias ll='ls -lh' la='ls -lAh' l='ls -lah'
bindkey '^y' forward-word
alias reload='exec zsh'
