#!/bin/sh
# op, already authenticated for this machine. Same command surface on every
# machine, so project instructions never name one.
# Usage: op-agent run --env-file <dotenv with op:// refs> -- <cmd>
#        op-agent read op://agents/<item>/<field> | <consumer>
# Service account scoped to the `agents` vault, read-only, one per machine.
# The token is read here and handed only to the op process: it never enters a
# shell environment, so nothing an agent spawns can inherit it.
token_file="$HOME/.config/op/agent.token"
# Without a token op falls back to the desktop app, which asks for the whole
# account instead of one vault.
[ -s "$token_file" ] || { echo "op-agent: $token_file missing or empty" >&2; exit 1; }
if [ "$1" = run ]; then
  # `op run` forwards its whole environment to <cmd>, token included.
  # Rebuild argv with `env -u OP_SERVICE_ACCOUNT_TOKEN` right after the first `--`.
  n=$#; i=0; done_=
  while [ "$i" -lt "$n" ]; do
    a=$1; shift; i=$((i + 1))
    set -- "$@" "$a"
    if [ -z "$done_" ] && [ "$a" = -- ]; then
      set -- "$@" env -u OP_SERVICE_ACCOUNT_TOKEN; done_=1
    fi
  done
fi
OP_SERVICE_ACCOUNT_TOKEN="$(cat "$token_file")" exec op "$@"
