#!/usr/bin/env bash
# One-time move of this machine's code from ~/workspace to ~/Work, with
# Claude Code's state that is keyed by absolute path: the folders in ~/.claude/projects (memory,
# sessions), the project entries and repo paths in ~/.claude.json (trust, local MCP servers),
# and the prompt history. README "Code lives in ~/Work". Delete this once fleet-check passes
# everywhere.
#
#   move-code-to-Work -n   show what would happen
#   move-code-to-Work      do it; from a plain terminal, with every Claude session closed
#
# Safe to run again: a run that stopped halfway picks up the Claude state that still has the
# old paths.
set -euo pipefail

dry=no
[ "${1:-}" = -n ] && dry=yes
run() { if [ $dry = yes ]; then echo "would: $*"; else "$@"; fi; }

ws=$HOME/workspace
new=$HOME/Work

# --- folders. source -> target, one pair per line; names here hold no newline or tab.
pairs=$(
  if [ -d "$ws" ]; then
    for src in "$ws"/* "$ws"/.[!.]*; do
      [ -e "$src" ] && printf '%s\t%s\n' "$src" "$new/${src##*/}"
    done
  fi
  true
)

# Everything is checked before anything moves. An empty folder in the way (Omarchy makes
# ~/Work/tries at install) is not a clash.
clash=
while IFS=$'\t' read -r src dst; do
  [ -n "$src" ] || continue
  if [ -e "$dst" ] && ! { [ -d "$dst" ] && [ -z "$(ls -A "$dst")" ]; }; then clash="$clash $dst"; fi
done <<<"$pairs"
if [ -n "$clash" ]; then echo "already there, nothing moved:$clash" >&2; exit 1; fi

if [ $dry = no ] && pgrep -x claude >/dev/null; then
  echo "a Claude session is running: it would keep writing to the old paths. Close them all first." >&2
  exit 1
fi

run mkdir -p "$new"
while IFS=$'\t' read -r src dst; do
  [ -n "$src" ] || continue
  if [ -d "$dst" ]; then run rmdir "$dst"; fi
  run mv "$src" "$dst"
done <<<"$pairs"
if [ -d "$ws" ]; then run rmdir "$ws"; fi

# --- Claude's project folders. Named after the path with every character that is no letter
# or digit turned into "-", so a name can't be decoded: map each moved project, not the prefix
# ~/workspace, which would also catch ~/workspace-old. Projects are taken from both sides so a
# second run finds them after the folders moved. A subfolder (~/workspace/cu/x) shares its
# project's prefix; so would ~/workspace/cu-x, which moved along anyway.
enc() { printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g'; }
moved_dir() { # <old path> <new path> [exact]
  local old_key new_key dir rest
  old_key=$(enc "$1"); new_key=$(enc "$2")
  for dir in "$HOME/.claude/projects/$old_key" "$HOME/.claude/projects/$old_key"-*; do
    [ -d "$dir" ] || continue
    rest=${dir##*/}; rest=${rest#"$old_key"}
    [ -z "$rest" ] || [ -z "${3:-}" ] || continue
    if [ -e "$HOME/.claude/projects/$new_key$rest" ]; then
      echo "kept, target exists: ${dir##*/}" >&2
    else
      run mv "$dir" "$HOME/.claude/projects/$new_key$rest"
    fi
  done
}
names=$(for d in "$ws" "$new"; do for p in "$d"/* "$d"/.[!.]*; do [ -e "$p" ] && echo "${p##*/}"; done; done | sort -u; true)
while read -r name; do
  [ -n "$name" ] && moved_dir "$ws/$name" "$new/$name"
done <<<"$names"
moved_dir "$ws" "$new" exact

# --- path-keyed entries in Claude's files. These hold real paths, so a prefix match is exact.
if ! command -v jq >/dev/null; then
  echo "no jq: ~/.claude.json and the prompt history keep the old paths" >&2
  exit 1
fi
mv_def='def mv: if . == $ws or startswith($ws + "/") then $work + ltrimstr($ws) else . end;'
# A path whose new name already has an entry keeps that one. ~/Work holds the code from now
# on, so its trust is revoked (README: never trusted, so nothing cloned there inherits it).
claude_json="$mv_def"'
  (.projects // {}) as $p
  | if .projects then .projects = (reduce ($p | to_entries[]) as $e ({};
      ($e.key | mv) as $k | if $k != $e.key and ($p | has($k)) then . else .[$k] = $e.value end))
    else . end
  | if .projects[$work] then .projects[$work].hasTrustDialogAccepted = false else . end
  | if .githubRepoPaths then .githubRepoPaths |= map_values(map(mv) | unique) else . end'
history="$mv_def"' if .project then .project |= mv else . end'

rewrite() { # <file> <jq program> [-c]: in place, private like the original, first copy kept
  local f=$1
  [ -f "$f" ] || return 0
  if [ $dry = yes ]; then
    echo "would: rewrite $f"
    return 0
  fi
  [ -e "$f.before-Work" ] || cp -p "$f" "$f.before-Work"
  (umask 077 && jq ${3:-} --arg ws "$ws" --arg work "$new" "$2" "$f" >"$f.tmp")
  mv "$f.tmp" "$f"
}
if [ $dry = yes ] && [ -f "$HOME/.claude.json" ]; then
  echo "old paths in ~/.claude.json:"
  jq -r --arg ws "$ws" '[(.projects // {} | keys[]), (.githubRepoPaths // {} | .[][])]
    | .[] | select(. == $ws or startswith($ws + "/"))' "$HOME/.claude.json"
  jq -r --arg work "$new" 'if .projects[$work].hasTrustDialogAccepted then "trust on \($work) revoked" else empty end' "$HOME/.claude.json"
fi
rewrite "$HOME/.claude.json" "$claude_json"
rewrite "$HOME/.claude/history.jsonl" "$history" -c

[ $dry = yes ] || echo "done. Not carried along: mise trust (asked again per project), herdr's saved panes, zoxide's list."
