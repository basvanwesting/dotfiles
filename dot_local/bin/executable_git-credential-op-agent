#!/bin/sh
# git credential helper: GitHub over https with the fine-grained PATs in the
# `agents` vault. A fine-grained PAT covers one resource owner, so the token is
# picked by the owner in the repo path; git only sends the path with
# credential.useHttpPath. Wiring (per machine, see README):
#   git config --global credential.https://github.com.useHttpPath true
#   git config --global credential.https://github.com.helper ''
#   git config --global --add credential.https://github.com.helper '!~/.local/bin/git-credential-op-agent'
# The empty entry drops helpers from system config (osxkeychain on macOS), which
# would otherwise store the token and answer with a stale one after a rotation.
# Read-only: `store` and `erase` are ignored, the vault is the only copy.
[ "$1" = get ] || exit 0
while IFS='=' read -r key value; do
  case $key in
    host) host=$value ;;
    path) path=$value ;;
  esac
done
[ "$host" = github.com ] || exit 0
# GitHub owners are case-insensitive.
case $(printf %s "${path%%/*}" | tr '[:upper:]' '[:lower:]') in
  fourstack) field=GH_TOKEN_FOURSTACK ;;
  basvanwesting) field=GH_TOKEN_PERSONAL ;;
  # Any other owner: no token of ours applies, git carries on without one.
  *) exit 0 ;;
esac
token=$("$HOME/.local/bin/op-agent" read "op://agents/github/$field") || exit 1
printf 'username=x-access-token\npassword=%s\n' "$token"
