#!/bin/sh
# Compares this machine to what its role expects (README "Fleet check"; global CLAUDE.md,
# Security). Review needs an object: the role in chezmoi is the declaration, this asks
# the running system whether it still holds. Reads state only, changes nothing, prints
# no secret. Exit 1 when a line says FAIL.
#
# Expectations hang on two facts rendered in at `chezmoi apply`:
#   agents  = an agent works here, so the machine holds a service-account token and
#             accepts SSH (the work is reached from elsewhere). desktop and server.
#   client  = I only sit here. No token, and nothing connects in.
role={{ .role | quote }}
os={{ .chezmoi.os | quote }}

case $role in
  desktop|server) agents=yes ;;
  client) agents=no ;;
  *) echo "fleet-check: role '$role' is not part of the fleet, nothing to check"; exit 0 ;;
esac

# Over ssh the PATH lacks the mise shims, and a tool that is not found reads as "not
# logged in".
PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

fail=0
ok()   { printf 'ok    %s\n' "$1"; }
bad()  { printf 'FAIL  %s\n' "$1"; fail=1; }
skip() { printf 'skip  %s\n' "$1"; }
# is <name> <want yes|no> <have yes|no>
is() { if [ "$2" = "$3" ]; then ok "$1: $3"; else bad "$1: $3, expected $2"; fi; }
yn() { if "$@" >/dev/null 2>&1; then echo yes; else echo no; fi; }

echo "fleet-check: $(uname -n), role $role, $os"

# --- what the machine holds
is "service-account token on disk" "$agents" "$(yn test -s "$HOME/.config/op/agent.token")"

extra=$(ls "$HOME/.config/op" 2>/dev/null | grep '\.token$' | grep -v '^agent\.token$' | tr '\n' ' ')
if [ -z "$extra" ]; then ok "other tokens in ~/.config/op: none"; else bad "other tokens in ~/.config/op: $extra"; fi

# By name, never by content: every role keeps keys in an agent, so anything in ~/.ssh
# that is not a public key or ssh's own bookkeeping is a private key on disk. agent/ is
# where ssh-agent puts its sockets since OpenSSH 10.1.
keys=$(ls "$HOME/.ssh" 2>/dev/null | grep -v -e '\.pub$' -e '^config$' -e '^known_hosts' -e '^authorized_keys' -e '^agent$' | tr '\n' ' ')
if [ -z "$keys" ]; then ok "private key files in ~/.ssh: none"; else bad "private key files in ~/.ssh: $keys"; fi

if command -v gh >/dev/null 2>&1; then
  # `auth token`, not `auth status`: status asks GitHub, so a stored token reads as
  # "not logged in" when offline or expired.
  is "plain gh holds a login" no "$(yn gh auth token)"
else
  skip "plain gh: not installed"
fi

# A logout keeps the key and empties it (access_token: ""), so only a value counts.
is "Fly login on disk" no "$(yn grep -Eq "^access_token: *([^\"' ]|\"[^\"]|'[^'])" "$HOME/.fly/config.yml")"

# Git config is asked from / with no --global: outside a repo that is the effective system
# and user config, includes followed. --global reads ~/.gitconfig alone once that file
# exists, and would miss the XDG file our block is included from.
gitcfg() { (cd / && git config --includes "$@" 2>/dev/null); }

# The reset in github.inc only drops helpers set before it. One set anywhere else (a
# `gh auth setup-git` line, osxkeychain in ~/.gitconfig) answers too, and a helper that
# stores would keep a copy of the PAT.
# System config is exempt: git reads it first, so the reset does drop it (osxkeychain as
# shipped with git on macOS), and it is not ours to edit.
# Exempt only a helper scoped to a literal other host (git.heroku.com): git never asks it for
# GitHub. An empty host (https://) or a wildcard (https://*.com) does match github.com.
# Tab-split: the origin path is unquoted and may hold spaces; the key ends at the first space.
stray=$(gitcfg --show-scope --show-origin --get-regexp '^credential\.(.*\.)?helper$' | grep -v -e '^system' -e 'github\.inc' | awk -F'\t' '{
  split($3, kv, " "); k = kv[1]
  if (k == "credential.helper") { print $2; next }
  host = substr(k, 12, length(k) - 18)      # between "credential." and ".helper"
  sub(/^[A-Za-z][A-Za-z0-9+.-]*:\/\//, "", host); sub(/\/.*/, "", host)
  if (host == "" || host ~ /\*/ || tolower(host) ~ /github/) print $2
}' | sort -u | tr '\n' ' ')
if [ -z "$stray" ]; then ok "github credential helpers set outside github.inc: none"; else bad "github credential helpers set outside github.inc: $stray"; fi
if [ "$agents" = yes ]; then
  # --get gives the last helper, the one that answers after the reset.
  is "git uses the vault PATs for github.com" yes \
    "$(if gitcfg --get credential.https://github.com.helper | grep -q git-credential-op-agent; then echo yes; else echo no; fi)"
  for rule in 'Read(~/.1password/agent.sock)' 'Read(~/.config/gh/hosts.yml)'; do
    is "Claude deny rule $rule" yes "$(yn grep -qF "$rule" "$HOME/.claude/settings.json")"
  done
fi

# Writing is mine on every role: a push to GitHub goes over ssh, whatever the remote's
# spelling. Reading is the agents' authority where agents work: fetch over https with the
# vault PAT. A client has no vault token, so there fetch is not rewritten.
push_rules=$(gitcfg --get-all url.ssh://git@github.com/.pushInsteadOf | sort | tr '\n' ' ')
is "github push goes over ssh" yes "$(yn test "$push_rules" = 'git@github.com: https://github.com/ ')"
fetch_url=$(cd / && git ls-remote --get-url git@github.com:o/r.git 2>/dev/null)
is "github fetch goes over https (vault PAT)" "$agents" "$(yn test "$fetch_url" = https://github.com/o/r.git)"
# The rules above are skipped or overruled by an explicit push URL, so ask one real clone.
if command -v chezmoi >/dev/null 2>&1 && dot_push=$(chezmoi git -- remote get-url --push origin 2>/dev/null); then
  case $dot_push in
    ssh://git@github.com/*) ok "dotfiles push URL: ssh" ;;
    *) bad "dotfiles push URL: $dot_push, expected ssh://git@github.com/... (unset remote.origin.pushurl)" ;;
  esac
else
  skip "dotfiles push URL: no chezmoi repo"
fi

# One code folder under one name on every machine (README "Code lives in ~/Work"): Claude keys
# a project's memory by its absolute path, so a second name splits it.
if [ -e "$HOME/workspace" ]; then bad "~/workspace beside ~/Work: yes (run move-code-to-Work)"; else ok "~/workspace beside ~/Work: none"; fi
# ~/Work holds every project, so a trust grant there would cover whatever is cloned into it.
# Claude also counts a trusted parent folder, so ~ is asked too.
if [ ! -f "$HOME/.claude.json" ]; then
  skip "Claude trust on ~ or ~/Work: no ~/.claude.json"
elif ! command -v jq >/dev/null 2>&1; then
  skip "Claude trust on ~ or ~/Work: no jq"
else
  is "Claude trust on ~ or ~/Work" no \
    "$(jq -r --arg h "$HOME" '[.projects[$h, $h + "/Work"].hasTrustDialogAccepted] | if any then "yes" else "no" end' "$HOME/.claude.json")"
fi

# --- what comes in from outside
# A fresh interactive shell, as an agent or I would get it: the caller's own env says
# nothing when this runs over ssh.
# The three are unset first: they are exported, so a shell started from one that has
# them would report them even with the rc block gone.
env_line=$(env -u HEX_COOLDOWN -u NPM_CONFIG_MIN_RELEASE_AGE -u UV_EXCLUDE_NEWER "${SHELL:-sh}" -ic 'echo "FC|$HEX_COOLDOWN|$NPM_CONFIG_MIN_RELEASE_AGE|$UV_EXCLUDE_NEWER|"' 2>/dev/null | grep '^FC|')
if [ "$env_line" = 'FC|1d|1|1 day|' ]; then
  ok "24h release cooldown (hex, npm, uv): set"
else
  bad "24h release cooldown (hex, npm, uv): got '${env_line:-nothing}'"
fi

# --- who can reach the machine
if command -v tailscale >/dev/null 2>&1 && prefs=$(tailscale debug prefs 2>/dev/null); then
  has() { if printf '%s' "$prefs" | grep -q "\"$1\": true"; then echo yes; else echo no; fi; }
  if [ "$agents" = no ]; then
    is "tailscale shields up" yes "$(has ShieldsUp)"
    is "tailscale ssh server" no "$(has RunSSH)"
  elif [ "$os" = linux ]; then
    is "tailscale shields up" no "$(has ShieldsUp)"
    is "tailscale ssh server" yes "$(has RunSSH)"
  else
    skip "tailscale ssh server: not available on $os"
  fi
  # --peers=false: the plain status also lists every peer, tags included.
  tagged=$(yn sh -c 'tailscale status --self --peers=false --json | grep -q "\"tag:server\""')
  if [ "$role" = server ]; then want=yes; else want=no; fi
  is "tagged tag:server (cannot initiate ssh)" "$want" "$tagged"
elif [ "$os" = linux ]; then
  bad "tailscale: cli not found or daemon not answering, so reach is unchecked"
else
  skip "tailscale: cli not on PATH (macOS app: install its CLI), reach is unchecked"
fi

# Everything but loopback, the tailnet interface and the docker bridge: those are not
# reachable from the LAN, a wildcard or LAN-address bind is. A bind to this machine's tailnet
# address (Syncthing) is different from a bind to the interface: Linux accepts a packet for
# any local address on any interface, so a LAN host that routes the address here reaches it.
# Only the firewall stops that, so such a listener is exempt only while ufw is on, denies
# incoming by default and no user rule can open its port. Fail-safe: every accepting rule
# counts as opening it, whatever its source or interface, unless it is on tailscale0 or
# names one other port; a --dports rule always counts (not parsed). before.rules is not
# read. TCP only: UDP has standing wildcard listeners (mDNS,
# tailscale) that would need a list of their own. A server's listeners are its job, so they
# are shown, not judged.
if [ "$os" = linux ] && command -v ss >/dev/null 2>&1; then
  ts4=$(tailscale ip -4 2>/dev/null | head -1)
  ufw_rules=/etc/ufw/user.rules
  fw_deny=false
  if systemctl is-active --quiet ufw 2>/dev/null && [ -r "$ufw_rules" ] \
    && grep -q '^ENABLED=yes' /etc/ufw/ufw.conf 2>/dev/null \
    && grep -Eq '^DEFAULT_INPUT_POLICY="?(DROP|REJECT)' /etc/default/ufw 2>/dev/null; then
    fw_deny=true
  fi
  open=$(ss -tlnH 2>/dev/null | awk '{print $4}' | grep -v -e '^127\.' -e '^\[::1\]' -e '%lo:' -e '%tailscale0:' -e '^172\.17\.' | sort -u | while read -r a; do
    if [ -n "$ts4" ] && [ "${a%:*}" = "$ts4" ] && $fw_deny \
      && ! awk -v p="${a##*:}" '
        /^-A ufw-user-input/ && /-j (ACCEPT|ufw-user-limit-accept)/ && !/ -i tailscale0 / {
          if (/--dports /) f = 1
          else if (/--dport /) { if (index($0, "--dport " p " ")) f = 1 }
          else f = 1
        }
        END { exit !f }' "$ufw_rules"; then
      continue
    fi
    printf '%s ' "$a"
  done)
  if [ "$role" = server ]; then
    echo "info  listeners reachable from the LAN: ${open:-none}"
  elif [ -z "$open" ]; then
    ok "listeners reachable from the LAN: none"
  else
    bad "listeners reachable from the LAN: $open"
  fi
else
  skip "listeners: no check on $os"
fi

# --- what a thief gets
if [ "$role" = server ]; then
  skip "disk encryption: the server boots unattended, its disk is unencrypted by decision"
elif [ "$os" = darwin ]; then
  is "disk encryption (FileVault)" yes "$(yn sh -c 'fdesetup status | grep -q "FileVault is On"')"
else
  # The device under /, not any LUKS device: an encrypted USB disk proves nothing.
  root_dev=$(findmnt -no SOURCE / 2>/dev/null | sed 's/\[.*//')
  is "disk encryption (LUKS under /)" yes "$(yn sh -c "lsblk -nso FSTYPE '$root_dev' | grep -q crypto_LUKS")"
fi

if [ "$fail" = 0 ]; then echo "fleet-check: matches role $role"; else echo "fleet-check: DRIFT from role $role"; fi
exit "$fail"
