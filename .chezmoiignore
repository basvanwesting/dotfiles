README.md
{{- /* Three OS layers: macOS (zsh stack, Homebrew), Omarchy (a managed Linux that
       owns bash, starship and git config; we stay downstream and only hook
       in), and bare Linux (nothing to stay downstream of, so the zsh stack applies).
       Omarchy is detected from /etc/os-release, not from the role. */ -}}
{{- $darwin := eq .chezmoi.os "darwin" -}}
{{- $omarchy := eq (get .chezmoi.osRelease "id") "omarchy" -}}
{{ if not $darwin }}
.Brewfile
.livebookdesktop.sh
# Its password commands need the 1Password app, wired on macOS only.
.config/himalaya
{{ end }}
{{ if $omarchy }}
# Omarchy ships these and keeps improving them; let it own them here.
# nvim is ours (README: Neovim on Omarchy); the omarchy-nvim package is removed.
.zshrc
.config/git/config
.config/starship.toml
{{ else }}
# modify_dot_bashrc only exists to hook ~/.config/shell/* into Omarchy's bashrc.
# Everywhere else zsh is the shell and dot_zshrc.tmpl sources them.
.bashrc
# nvim's Omarchy hook-ins: the theme symlink points into Omarchy's state dir.
.config/nvim/lua/custom/omarchy
.config/nvim/lua/custom/omarchy/**
{{ end }}
{{ if ne .role "server" }}
# Only the headless server keeps a private key on disk. Desktops use the
# 1Password SSH agent, so this must never materialize there.
.ssh/id_ed25519
# herdr as a lingering user service is a server thing; desktops start herdr on demand.
# Whole tree, not just the unit: otherwise the empty directories still materialize.
.config/systemd
.config/systemd/**
{{ else if not (env "OP_SERVICE_ACCOUNT_TOKEN") }}
# The key template reads the ser8-host vault, which only the provisioning token
# can see. Without a token in the environment the key is left as it is on disk,
# so a plain apply/diff/update needs none. Provisioning: see README.
.ssh/id_ed25519
{{ end }}
