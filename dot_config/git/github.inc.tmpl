# Managed by chezmoi; included from ~/.config/git/config. README "Git and GitHub".
#
# Two decisions meet here; README "Git and GitHub" has both.
# - Security, enforced by GitHub: the vault PATs can write the project repos, never the
#   dotfiles, since a dotfiles push installs on every machine. fleet-check asks GitHub.
# - Project management, not security: agents don't push project code, because unpushed
#   commits are my todo list in herdr. So every push to GitHub goes over SSH and needs my
#   key (the 1Password prompt on a desktop or client, a forwarded agent on the server),
#   whatever the remote's spelling. A guard against a slip, not a wall: pushInsteadOf skips
#   a remote with an explicit push URL. board-data, below, is the exception.
[url "ssh://git@github.com/"]
	pushInsteadOf = https://github.com/
	pushInsteadOf = git@github.com:
{{- if or (eq .role "desktop") (eq .role "server") }}

# Reading is the agents' authority: fetch goes over https with the PATs from
# the `agents` vault, so an agent's fetch never touches my key and the keyless server can
# fetch at all. `ssh://` as a fetch URL is not rewritten: that spelling means "use my key",
# for a private repo no PAT covers. insteadOf also rewrites an explicit push URL, so one
# spelled git@github.com: goes out over https with the PAT: it pushes a project repo (the
# slip this guard is for) and gets a 403 on the dotfiles. Spell it ssh:// or drop it.
[url "https://github.com/"]
	insteadOf = git@github.com:

# board-data is the agents' to push: the `board` tool pushes it on every write, from every
# agent machine, the keyless server included. It holds the todos itself, so there is no
# unpushed state for me to track, and my key would only raise a 1Password prompt per write.
# git takes the longest matching pushInsteadOf, so this identity rule keeps its pushes on
# https with the PAT, in either spelling, and leaves every other push on SSH. It is a
# prefix, so a future fourstack/board-data* repo would be caught too.
[url "https://github.com/fourstack/board-data"]
	pushInsteadOf = https://github.com/fourstack/board-data
	pushInsteadOf = git@github.com:fourstack/board-data

# The owner in the URL picks the PAT, so git must send the path. The empty helper drops
# every helper set before this point (system config, a `gh auth setup-git` line), so the
# vault stays the only copy and a stale token can't answer. It cannot drop one set later:
# in ~/.gitconfig, which git reads after this file, or appended below the include.
# fleet-check fails on any helper outside this file that could answer for GitHub.
[credential "https://github.com"]
	useHttpPath = true
	helper =
	helper = !~/.local/bin/git-credential-op-agent
{{- else }}

# No agents work here, so there is no vault token to fetch with: fetch is not rewritten.
{{- end }}
