{{- $darwin := eq .chezmoi.os "darwin" -}}
# Ghostty is only the outer terminal: herdr owns tabs, splits and their chords.
# Shared body (Omarchy-derived); per-OS fragments are gated inline.
{{ if $darwin }}
# Palette: Ghostty's built-in TokyoNight Night, same flavour as nvim's
# tokyonight-night and herdr's "tokyo-night" theme drawn on top.
theme = TokyoNight Night
{{ else }}
# Omarchy theme colors (Omarchy 4 keeps the current theme under ~/.local/state).
# Included first so the explicit settings below win if a theme ever overlaps.
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"
{{ end }}
# Font (family shared; size is per machine, screens differ)
font-family = "JetBrainsMono Nerd Font"
font-style = Regular
font-size = {{ if $darwin }}13{{ else }}9{{ end }}

# Window
window-theme = ghostty
window-padding-x = 14
window-padding-y = 14
confirm-close-surface = false
resize-overlay = never
{{- if not $darwin }}
gtk-toolbar-style = flat
{{- end }}

# Cursor styling
cursor-style = "block"
cursor-style-blink = false

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
shell-integration-features = no-cursor,ssh-env

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95
{{ if $darwin }}
# Left Option acts as Alt so herdr's alt+1..9 / alt+arrows navigation matches
# Omarchy; right Option still composes accents (Dutch layout).
macos-option-as-alt = left
{{- else }}
# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll
{{- end }}

# Keyboard bindings
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
# Send Shift+Enter as CSI-u so TUIs can distinguish it from Enter.
keybind = shift+enter=csi:13;2u

# Every default tab/split/surface bind is unbound (ghostty +list-keybinds --default).
# The macOS and Linux lists differ because ghostty's defaults differ per OS:
# regenerate each from that command on its own OS, never merge them.
{{ if $darwin -}}
# alt+left/right default to esc:b / esc:f (word movement); herdr needs them for tabs.
keybind = alt+arrow_left=unbind
keybind = alt+arrow_right=unbind
keybind = ctrl+shift+tab=unbind
keybind = ctrl+tab=unbind
keybind = super+1=unbind
keybind = super+2=unbind
keybind = super+3=unbind
keybind = super+4=unbind
keybind = super+5=unbind
keybind = super+6=unbind
keybind = super+7=unbind
keybind = super+8=unbind
keybind = super+9=unbind
keybind = super+[=unbind
keybind = super+]=unbind
keybind = super+alt+arrow_down=unbind
keybind = super+alt+arrow_left=unbind
keybind = super+alt+arrow_right=unbind
keybind = super+alt+arrow_up=unbind
keybind = super+alt+w=unbind
keybind = super+ctrl+=unbind
keybind = super+ctrl+arrow_down=unbind
keybind = super+ctrl+arrow_left=unbind
keybind = super+ctrl+arrow_right=unbind
keybind = super+ctrl+arrow_up=unbind
keybind = super+d=unbind
keybind = super+digit_1=unbind
keybind = super+digit_2=unbind
keybind = super+digit_3=unbind
keybind = super+digit_4=unbind
keybind = super+digit_5=unbind
keybind = super+digit_6=unbind
keybind = super+digit_7=unbind
keybind = super+digit_8=unbind
keybind = super+shift+[=unbind
keybind = super+shift+]=unbind
keybind = super+shift+d=unbind
keybind = super+shift+enter=unbind
keybind = super+t=unbind
keybind = super+w=unbind
{{- else -}}
# alt+1..9 and ctrl+alt+arrows collide with herdr's switch_tab / focus_pane otherwise.
keybind = alt+1=unbind
keybind = alt+2=unbind
keybind = alt+3=unbind
keybind = alt+4=unbind
keybind = alt+5=unbind
keybind = alt+6=unbind
keybind = alt+7=unbind
keybind = alt+8=unbind
keybind = alt+9=unbind
keybind = alt+digit_1=unbind
keybind = alt+digit_2=unbind
keybind = alt+digit_3=unbind
keybind = alt+digit_4=unbind
keybind = alt+digit_5=unbind
keybind = alt+digit_6=unbind
keybind = alt+digit_7=unbind
keybind = alt+digit_8=unbind
keybind = ctrl+alt+arrow_down=unbind
keybind = ctrl+alt+arrow_left=unbind
keybind = ctrl+alt+arrow_right=unbind
keybind = ctrl+alt+arrow_up=unbind
keybind = ctrl+page_down=unbind
keybind = ctrl+page_up=unbind
keybind = ctrl+shift+arrow_left=unbind
keybind = ctrl+shift+arrow_right=unbind
keybind = ctrl+shift+e=unbind
keybind = ctrl+shift+enter=unbind
keybind = ctrl+shift+o=unbind
keybind = ctrl+shift+tab=unbind
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+w=unbind
keybind = ctrl+tab=unbind
keybind = super+ctrl+]=unbind
keybind = super+ctrl+[=unbind
keybind = super+ctrl+shift+arrow_down=unbind
keybind = super+ctrl+shift+arrow_left=unbind
keybind = super+ctrl+shift+arrow_right=unbind
keybind = super+ctrl+shift+arrow_up=unbind
{{- end }}
