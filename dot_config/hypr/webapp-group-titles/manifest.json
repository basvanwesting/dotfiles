{
  "manifest_version": 3,
  "name": "Webapp group titles",
  "description": "Retitles the mail web apps to their address and unread count, for the window group bar.",
  "version": "1",
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.cloud.microsoft/*"
      ],
      "js": ["labels.js", "titles.js"],
      "run_at": "document_idle"
    }
  ]
}
